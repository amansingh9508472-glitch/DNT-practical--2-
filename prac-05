EmployeeCalendar.aspx
<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="EmployeeCalendar.aspx.cs"
    Inherits="LeaveApplication.EmployeeCalendar" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Employee Calendar</title>

    <style>
        body {
            margin: 0;
            padding: 12px;
            font-family: Arial;
            background: white;
        }

        /* Employee Calendar */

        .calendar-page {
            width: 270px;
        }

        .calendar-page h2 {
            font-family: Georgia;
            font-size: 22px;
            margin: 0 0 18px 0;
        }

        .calendar {
            width: 260px;
            border: 1px solid #777;
        }

        .calendar-header {
            height: 28px;
            background: #ccc;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .calendar-header span {
            padding: 0 4px;
        }

        .month {
            flex: 1;
            text-align: center;
        }

        .calendar table {
            width: 100%;
            border-collapse: collapse;
        }

        .calendar th {
            font-size: 14px;
            padding: 2px;
        }

        .calendar td {
            text-align: center;
            padding: 3px;
            font-size: 14px;
        }

        .date-btn {
            border: none;
            background: transparent;
            text-decoration: underline;
            cursor: pointer;
            font-size: 14px;
            padding: 1px;
        }

        .date-btn:hover {
            background: #ccc;
        }

        .selected-label {
            margin-top: 20px;
            margin-bottom: 4px;
        }

        .selected-date {
            width: 160px;
            height: 20px;
        }

        .apply-link {
            display: block;
            margin-top: 20px;
            color: purple;
            text-decoration: underline;
            cursor: pointer;
        }


        /* Leave Application */

        .leave-box {
            width: 500px;
            margin-top: 50px;
            padding: 25px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 0 10px #d0d0d0;
        }

        .leave-box h1 {
            font-size: 24px;
            margin-top: 18px;
            margin-bottom: 22px;
        }

        .field-label {
            display: block;
            font-weight: bold;
            margin-bottom: 7px;
        }

        .text-input,
        .select-input,
        .date-input,
        .reason-input {
            width: 100%;
            box-sizing: border-box;
            border: 1px solid #aaa;
            padding: 10px;
            margin-bottom: 14px;
            font-size: 13px;
        }

        .select-input {
            background: #eeeef2;
        }

        .reason-input {
            height: 82px;
            resize: both;
        }

        .apply-button {
            width: 100%;
            height: 37px;
            border: none;
            border-radius: 3px;
            background: #0865b9;
            color: white;
            cursor: pointer;
        }

        .success-message {
            display: block;
            margin-top: 16px;
            color: green;
        }
    </style>
</head>

<body>

